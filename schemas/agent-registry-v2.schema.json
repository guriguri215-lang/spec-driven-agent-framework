{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/agent-registry-v2.schema.json",
  "title": "Agent Registry v2",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "role_id",
          "display_name",
          "responsibilities",
          "inputs",
          "outputs",
          "tools",
          "prohibited_actions",
          "problem_types",
          "scales",
          "max_risk",
          "parallelism",
          "can_write",
          "independent_reviewer"
        ],
        "properties": {
          "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 500},
          "responsibilities": {"$ref": "#/$defs/nonemptyStrings"},
          "inputs": {"$ref": "#/$defs/nonemptyStrings"},
          "outputs": {"$ref": "#/$defs/nonemptyStrings"},
          "tools": {"$ref": "#/$defs/nonemptySlugs"},
          "prohibited_actions": {"$ref": "#/$defs/nonemptyStrings"},
          "problem_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["discovery", "implementation", "test_design", "log_analysis", "review"]
            }
          },
          "scales": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["small", "medium", "large"]}
          },
          "max_risk": {"enum": ["low", "medium", "high", "prohibited"]},
          "parallelism": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["sequential", "read_parallel", "write_parallel"]}
          },
          "can_write": {"type": "boolean"},
          "independent_reviewer": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "nonemptySlugs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    }
  },
  "additionalProperties": false
}
