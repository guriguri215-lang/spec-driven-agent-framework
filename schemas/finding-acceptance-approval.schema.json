{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/finding-acceptance-approval.schema.json",
  "title": "Critical Review Finding Acceptance",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "action",
    "scope",
    "risk",
    "status",
    "rationale",
    "reversible",
    "approved_by",
    "approved_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "pattern": "^APR-[A-Z0-9][A-Z0-9-]{0,63}$"},
    "approval_type": {"const": "owner"},
    "action": {"const": "Accept independent review finding"},
    "scope": {
      "type": "object",
      "required": [
        "review_id",
        "finding_id",
        "finding_sha256",
        "candidate"
      ],
      "properties": {
        "review_id": {"type": "string", "pattern": "^REV-[A-Z0-9][A-Z0-9-]{0,63}$"},
        "finding_id": {"type": "string", "pattern": "^FND-[A-Z0-9][A-Z0-9-]{0,63}$"},
        "finding_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "candidate": {
          "type": "object",
          "required": [
            "source_spec_sha256",
            "git_head",
            "repository_digest"
          ],
          "properties": {
            "source_spec_sha256": {
              "type": "string",
              "pattern": "^[0-9A-F]{64}$"
            },
            "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "repository_digest": {
              "type": "string",
              "pattern": "^[0-9A-F]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "risk": {"const": "high"},
    "status": {"const": "approved"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
    "reversible": {"const": true},
    "approved_by": {"const": "Owner"},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
