{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/claim-evidence-ledger.schema.json",
  "title": "Claim-Evidence Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "source_spec_sha256",
    "git_head",
    "repository_digest",
    "claims",
    "evidence",
    "diff_review_evidence_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "baseline_id": {"type": "string", "pattern": "^RB-[0-9A-F]{16}$"},
    "source_spec_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_digest": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/claim"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "diff_review_evidence_id": {"$ref": "#/$defs/evidenceId"}
  },
  "$defs": {
    "claimId": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "statement",
        "requirement_ids",
        "acceptance_criteria",
        "state",
        "criticality",
        "confidence"
      ],
      "properties": {
        "claim_id": {"$ref": "#/$defs/claimId"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,99}$"}
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^AC-[A-Z0-9][A-Z0-9-]{1,119}$"}
        },
        "state": {
          "enum": ["implemented", "verified", "unverified", "known_problem"]
        },
        "criticality": {
          "enum": ["normal", "must", "security", "data_loss", "disclosure"]
        },
        "confidence": {"enum": ["A", "B", "C", "D"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "claim_ids",
        "type",
        "status",
        "command",
        "environment",
        "commit",
        "repository_digest",
        "artifacts",
        "recorded_at"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/evidenceId"},
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/claimId"}
        },
        "type": {
          "enum": [
            "TEST",
            "STATIC_ANALYSIS",
            "TYPE_CHECK",
            "BENCHMARK",
            "VISUAL",
            "MANUAL_REVIEW",
            "SOURCE_REVIEW",
            "UNVERIFIED"
          ]
        },
        "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|/(?:[Ee]tc|[Hh]ome|[Oo]pt|[Pp]rivate|[Rr]oot|[Tt]mp|[Uu]sr|[Vv]ar|[Uu]sers)(?:/|$)))(?!.*(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----))[^\\x00-\\x1F\\x7F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "environment": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|/(?:[Ee]tc|[Hh]ome|[Oo]pt|[Pp]rivate|[Rr]oot|[Tt]mp|[Uu]sr|[Vv]ar|[Uu]sers)(?:/|$)))(?!.*(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----))[^\\x00-\\x1F\\x7F\\u202A-\\u202E\\u2066-\\u2069]+$"
          }
        },
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_digest": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "artifacts": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "recorded_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}},
          "then": {"properties": {"artifacts": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "NOT_VERIFIED"}}},
          "then": {"properties": {"type": {"const": "UNVERIFIED"}}}
        },
        {
          "if": {"properties": {"type": {"const": "UNVERIFIED"}}},
          "then": {"properties": {"status": {"const": "NOT_VERIFIED"}}}
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\.(?:/|$))(?!.*/$)(?!.*(?:^|/)~)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
