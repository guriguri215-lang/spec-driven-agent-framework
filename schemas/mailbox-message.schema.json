{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/mailbox-message.schema.json",
  "title": "M6 Mailbox Message",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_id", "content"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "mailbox-message"},
    "artifact_id": {"$ref": "task-graph.schema.json#/$defs/message_id"},
    "content": {
      "type": "object",
      "required": [
        "message_type",
        "direction",
        "sender",
        "recipient",
        "graph_id",
        "task_id",
        "candidate",
        "context_snapshot_id",
        "attempt",
        "lease_id",
        "fence",
        "idempotency_key",
        "sensitivity",
        "provenance",
        "causal_parent_message_ids",
        "recorded_at",
        "payload"
      ],
      "properties": {
        "message_type": {
          "enum": [
            "dispatch_intent",
            "dispatch_acknowledgement",
            "heartbeat",
            "task_result",
            "cancel_request",
            "cancel_acknowledgement",
            "worktree_request",
            "worktree_observation",
            "approval_decision",
            "capability_observation"
          ]
        },
        "direction": {
          "enum": [
            "scheduler_to_host",
            "host_to_scheduler",
            "owner_to_scheduler"
          ]
        },
        "sender": {"$ref": "task-graph.schema.json#/$defs/host_or_worker_id"},
        "recipient": {
          "$ref": "task-graph.schema.json#/$defs/host_or_worker_id"
        },
        "graph_id": {"$ref": "task-graph.schema.json#/$defs/task_graph_id"},
        "task_id": {"$ref": "#/$defs/nullable_task"},
        "candidate": {"$ref": "task-graph.schema.json#/$defs/candidate"},
        "context_snapshot_id": {"$ref": "#/$defs/nullable_context"},
        "attempt": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 3}
          ]
        },
        "lease_id": {"$ref": "#/$defs/nullable_lease"},
        "fence": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 2147483647}
          ]
        },
        "idempotency_key": {"$ref": "#/$defs/nullable_idempotency"},
        "sensitivity": {"$ref": "task-graph.schema.json#/$defs/sensitivity"},
        "provenance": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "task-graph.schema.json#/$defs/reference"}
        },
        "causal_parent_message_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"$ref": "task-graph.schema.json#/$defs/message_id"}
        },
        "recorded_at": {"$ref": "task-graph.schema.json#/$defs/timestamp"},
        "payload": {"type": "object"}
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "dispatch_intent"},
            "direction": {"const": "scheduler_to_host"},
            "payload": {"$ref": "#/$defs/dispatch_intent"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "dispatch_acknowledgement"},
            "direction": {"const": "host_to_scheduler"},
            "payload": {"$ref": "#/$defs/dispatch_acknowledgement"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "heartbeat"},
            "direction": {"const": "host_to_scheduler"},
            "payload": {"$ref": "#/$defs/heartbeat"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "task_result"},
            "direction": {"const": "host_to_scheduler"},
            "payload": {"$ref": "#/$defs/task_result"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "cancel_request"},
            "direction": {"const": "scheduler_to_host"},
            "payload": {"$ref": "#/$defs/cancel_request"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "cancel_acknowledgement"},
            "direction": {"const": "host_to_scheduler"},
            "payload": {"$ref": "#/$defs/cancel_acknowledgement"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "worktree_request"},
            "direction": {"const": "scheduler_to_host"},
            "payload": {"$ref": "#/$defs/worktree_request"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "worktree_observation"},
            "direction": {"const": "host_to_scheduler"},
            "payload": {"$ref": "#/$defs/worktree_observation"}
          }
        },
        {
          "$ref": "#/$defs/task_bound",
          "properties": {
            "message_type": {"const": "approval_decision"},
            "direction": {"const": "owner_to_scheduler"},
            "payload": {"$ref": "#/$defs/approval_decision"}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "payload": {
                    "properties": {"approval_type": {"const": "owner"}}
                  }
                }
              },
              "then": {
                "properties": {
                  "sender": {"const": "HST-OWNER"},
                  "payload": {
                    "properties": {"authority": {"const": "Owner"}}
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "payload": {
                    "properties": {"approval_type": {"const": "technical_sandbox"}}
                  }
                }
              },
              "then": {
                "properties": {
                  "sender": {"const": "HST-TECHNICAL-SANDBOX"},
                  "payload": {
                    "properties": {
                      "authority": {"const": "Technical sandbox reviewer"}
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "message_type": {"const": "capability_observation"},
            "direction": {"const": "host_to_scheduler"},
            "task_id": {"type": "null"},
            "context_snapshot_id": {"type": "null"},
            "attempt": {"type": "null"},
            "lease_id": {"type": "null"},
            "fence": {"type": "null"},
            "idempotency_key": {"type": "null"},
            "payload": {"$ref": "#/$defs/capability_observation"}
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nullable_task": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "task-graph.schema.json#/$defs/task_id"}
      ]
    },
    "nullable_context": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "task-graph.schema.json#/$defs/context_snapshot_id"}
      ]
    },
    "nullable_lease": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "task-graph.schema.json#/$defs/lease_id"}
      ]
    },
    "nullable_idempotency": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "task-graph.schema.json#/$defs/idempotency_key"}
      ]
    },
    "task_bound": {
      "properties": {
        "task_id": {"$ref": "task-graph.schema.json#/$defs/task_id"},
        "context_snapshot_id": {
          "$ref": "task-graph.schema.json#/$defs/context_snapshot_id"
        },
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "lease_id": {"$ref": "task-graph.schema.json#/$defs/lease_id"},
        "fence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "idempotency_key": {
          "$ref": "task-graph.schema.json#/$defs/idempotency_key"
        }
      }
    },
    "dispatch_intent": {
      "type": "object",
      "required": [
        "effect_digest",
        "lease_ttl_seconds",
        "heartbeat_interval_seconds",
        "required_capabilities",
        "required_tools",
        "context_bytes",
        "budget_reservation"
      ],
      "properties": {
        "effect_digest": {"$ref": "task-graph.schema.json#/$defs/sha256"},
        "lease_ttl_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "heartbeat_interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        },
        "required_capabilities": {
          "$ref": "task-graph.schema.json#/$defs/string_set"
        },
        "required_tools": {"$ref": "task-graph.schema.json#/$defs/string_set"},
        "context_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "budget_reservation": {"$ref": "#/$defs/dispatch_budget"}
      },
      "additionalProperties": false
    },
    "dispatch_acknowledgement": {
      "type": "object",
      "required": ["accepted", "effect_observed", "note"],
      "properties": {
        "accepted": {"type": "boolean"},
        "effect_observed": {"enum": ["none", "possible", "confirmed"]},
        "note": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/path_free_text"}
          ]
        }
      },
      "additionalProperties": false
    },
    "heartbeat": {
      "type": "object",
      "required": ["progress"],
      "properties": {
        "progress": {"$ref": "#/$defs/path_free_text"}
      },
      "additionalProperties": false
    },
    "task_result": {
      "type": "object",
      "required": [
        "agent_result",
        "outcome",
        "effect_observed",
        "evidence_refs",
        "budget_usage"
      ],
      "properties": {
        "agent_result": {"$ref": "task-graph.schema.json#/$defs/reference"},
        "outcome": {"enum": ["succeeded", "failed", "unknown"]},
        "effect_observed": {"enum": ["none", "confirmed", "ambiguous"]},
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "task-graph.schema.json#/$defs/reference"}
        },
        "budget_usage": {"$ref": "#/$defs/result_budget"}
      },
      "additionalProperties": false
    },
    "cancel_request": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {"$ref": "#/$defs/path_free_text"}
      },
      "additionalProperties": false
    },
    "cancel_acknowledgement": {
      "type": "object",
      "required": ["cancelled", "effect_observed"],
      "properties": {
        "cancelled": {"type": "boolean"},
        "effect_observed": {"enum": ["none", "confirmed", "ambiguous"]}
      },
      "additionalProperties": false
    },
    "worktree_request": {
      "type": "object",
      "required": ["worktree", "owned_paths"],
      "properties": {
        "worktree": {"$ref": "task-graph.schema.json#/$defs/safe_path"},
        "owned_paths": {"$ref": "task-graph.schema.json#/$defs/path_set"}
      },
      "additionalProperties": false
    },
    "worktree_observation": {
      "type": "object",
      "required": ["worktree", "observed_digest", "state"],
      "properties": {
        "worktree": {"$ref": "task-graph.schema.json#/$defs/safe_path"},
        "observed_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "task-graph.schema.json#/$defs/sha256"}
          ]
        },
        "state": {"enum": ["created", "unchanged", "integrated", "ambiguous"]}
      },
      "additionalProperties": false
    },
    "approval_decision": {
      "type": "object",
      "required": [
        "approval_id",
        "approval_type",
        "decision",
        "transition",
        "effect_digest",
        "approved_at",
        "expires_at",
        "authority",
        "supersedes_approval_id"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^APR-[A-Z0-9][A-Z0-9-]{0,95}$"
        },
        "approval_type": {"enum": ["owner", "technical_sandbox"]},
        "decision": {"enum": ["approved", "rejected"]},
        "transition": {"$ref": "#/$defs/path_free_text_100"},
        "effect_digest": {"$ref": "task-graph.schema.json#/$defs/sha256"},
        "approved_at": {"$ref": "task-graph.schema.json#/$defs/timestamp"},
        "expires_at": {"$ref": "task-graph.schema.json#/$defs/timestamp"},
        "authority": {"$ref": "#/$defs/path_free_text_200"},
        "supersedes_approval_id": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^APR-[A-Z0-9][A-Z0-9-]{0,95}$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "capability_observation": {
      "type": "object",
      "required": ["capabilities"],
      "properties": {
        "capabilities": {"$ref": "task-graph.schema.json#/$defs/string_set"}
      },
      "additionalProperties": false
    },
    "path_free_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$",
      "allOf": [
        {"not": {"pattern": "AKIA[0-9A-Z]{16}"}},
        {"not": {"pattern": "gh[pousr]_[A-Za-z0-9]{20,}"}},
        {
          "not": {
            "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
          }
        },
        {"not": {"pattern": "[A-Za-z]:[\\\\/]"}},
        {
          "not": {
            "pattern": "/(?:[Ee][Tt][Cc]|[Hh][Oo][Mm][Ee]|[Oo][Pp][Tt]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Rr][Oo][Oo][Tt]|[Tt][Mm][Pp]|[Uu][Ss][Rr]|[Vv][Aa][Rr]|[Uu][Ss][Ee][Rr][Ss])(?:/|$)"
          }
        }
      ]
    },
    "path_free_text_100": {
      "$ref": "#/$defs/path_free_text",
      "maxLength": 100
    },
    "path_free_text_200": {
      "$ref": "#/$defs/path_free_text",
      "maxLength": 200
    },
    "dispatch_budget": {
      "type": "object",
      "required": [
        "context_bytes",
        "microunits",
        "solver_calls",
        "solver_steps",
        "tool_calls"
      ],
      "properties": {
        "context_bytes": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "microunits": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "solver_calls": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "solver_steps": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000000000000000}
      },
      "additionalProperties": false
    },
    "result_budget": {
      "type": "object",
      "required": ["microunits", "solver_calls", "solver_steps", "tool_calls"],
      "properties": {
        "microunits": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "solver_calls": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "solver_steps": {"type": "integer", "minimum": 0, "maximum": 1000000000000000},
        "tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000000000000000}
      },
      "additionalProperties": false
    }
  }
}
