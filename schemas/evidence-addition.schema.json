{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/evidence-addition.schema.json",
  "title": "Standalone Evidence Addition",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "claim_ids",
    "type",
    "status",
    "command",
    "environment",
    "commit",
    "repository_digest",
    "artifacts",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9][A-Z0-9-]{0,63}$"
      }
    },
    "type": {
      "enum": [
        "TEST",
        "STATIC_ANALYSIS",
        "TYPE_CHECK",
        "BENCHMARK",
        "VISUAL",
        "MANUAL_REVIEW",
        "SOURCE_REVIEW",
        "UNVERIFIED"
      ]
    },
    "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|/(?:[Ee]tc|[Hh]ome|[Oo]pt|[Pp]rivate|[Rr]oot|[Tt]mp|[Uu]sr|[Vv]ar|[Uu]sers)(?:/|$)))(?!.*(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----))[^\\x00-\\x1F\\x7F\\u202A-\\u202E\\u2066-\\u2069]+$"
      }
    },
    "environment": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,31}$"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^(?!.*(?:[A-Za-z]:[\\\\/]|/(?:[Ee]tc|[Hh]ome|[Oo]pt|[Pp]rivate|[Rr]oot|[Tt]mp|[Uu]sr|[Vv]ar|[Uu]sers)(?:/|$)))(?!.*(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----))[^\\x00-\\x1F\\x7F\\u202A-\\u202E\\u2066-\\u2069]+$"
      }
    },
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_digest": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\.(?:/|$))(?!.*/$)(?!.*(?:^|/)~)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {"properties": {"artifacts": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "NOT_VERIFIED"}}},
      "then": {"properties": {"type": {"const": "UNVERIFIED"}}}
    },
    {
      "if": {"properties": {"type": {"const": "UNVERIFIED"}}},
      "then": {"properties": {"status": {"const": "NOT_VERIFIED"}}}
    }
  ]
}
