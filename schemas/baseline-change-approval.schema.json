{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/baseline-change-approval.schema.json",
  "title": "Requirement Baseline Change Approval",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "action",
    "scope",
    "risk",
    "status",
    "rationale",
    "reversible",
    "approved_by",
    "approved_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9-]+$"
    },
    "approval_type": {
      "const": "owner"
    },
    "action": {
      "const": "Approve requirement baseline changes"
    },
    "scope": {
      "type": "object",
      "required": [
        "previous_baseline_id",
        "current_baseline_id",
        "change_ids"
      ],
      "properties": {
        "previous_baseline_id": {
          "type": "string",
          "pattern": "^RB-[0-9A-F]{16}$"
        },
        "current_baseline_id": {
          "type": "string",
          "pattern": "^RB-[0-9A-F]{16}$"
        },
        "change_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CHG-[0-9A-F]{12}$"
          }
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "enum": [
        "medium",
        "high"
      ]
    },
    "status": {
      "const": "approved"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reversible": {
      "const": true
    },
    "approved_by": {
      "const": "Owner"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
