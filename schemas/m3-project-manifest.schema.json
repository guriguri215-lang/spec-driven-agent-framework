{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/m3-project-manifest.schema.json",
  "title": "M3 UI Classification Manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "title", "release_level", "source_spec", "platforms", "ui", "network_policy", "api_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "release_level": {"type": "string", "minLength": 1, "maxLength": 100},
    "source_spec": {
      "type": "object",
      "required": ["filename", "sha256", "imported_at"],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^(?![.]+$)(?!.*[.]$)(?![~])(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|$))[A-Za-z0-9._-]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
        "imported_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "platforms": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux", "macos"]}
        },
        "optional": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["windows", "linux", "macos"]}
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "required": ["present"],
      "properties": {"present": {"type": "boolean"}},
      "additionalProperties": false
    },
    "network_policy": {"enum": ["default-deny", "restricted", "allowed"]},
    "api_required": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "platforms": {
            "properties": {
              "required": {"contains": {"const": "windows"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "optional": {"not": {"contains": {"const": "windows"}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platforms": {
            "properties": {
              "required": {"contains": {"const": "linux"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "optional": {"not": {"contains": {"const": "linux"}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platforms": {
            "properties": {
              "required": {"contains": {"const": "macos"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "platforms": {
            "properties": {
              "optional": {"not": {"contains": {"const": "macos"}}}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
