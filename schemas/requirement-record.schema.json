{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/requirement-record.schema.json",
  "title": "Requirement Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "priority",
    "status",
    "source",
    "statement",
    "acceptance_criteria",
    "verification_methods",
    "assumptions",
    "open_questions",
    "trace_links",
    "identifier_source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "functional",
        "nonfunctional",
        "constraint",
        "non-goal",
        "assumption",
        "open-decision"
      ]
    },
    "priority": {
      "enum": [
        "must",
        "should",
        "could"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "baselined",
        "implemented",
        "verified",
        "rejected"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "document",
        "section",
        "line_start",
        "line_end",
        "excerpt",
        "derivation_basis"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.{1,2}$)[^/\\\\:\\r\\n\\u0000]+$"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "derivation_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "verification_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trace_links": {
      "type": "object",
      "required": [
        "design",
        "code",
        "tests",
        "evidence",
        "releases"
      ],
      "properties": {
        "design": {
          "$ref": "#/$defs/stringArray"
        },
        "code": {
          "$ref": "#/$defs/stringArray"
        },
        "tests": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence": {
          "$ref": "#/$defs/stringArray"
        },
        "releases": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "identifier_source": {
      "enum": [
        "explicit",
        "generated"
      ]
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "verification_methods"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
