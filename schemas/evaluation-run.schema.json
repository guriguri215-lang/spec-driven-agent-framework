{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/evaluation-run.schema.json",
  "title": "M4 Evaluation Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "workflow",
    "input_identity",
    "intervention",
    "intervention_sha256",
    "requirements_implemented",
    "scope_additions",
    "critical_defects",
    "rework_events",
    "approvals",
    "handoffs",
    "trace",
    "decisions",
    "evidence",
    "cause_analyses",
    "cost",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9][A-Z0-9-]{0,63}$"},
    "workflow": {
      "enum": ["structured_sdaqf", "ordinary_unstructured_codex"]
    },
    "input_identity": {
      "type": "object",
      "required": [
        "project_id",
        "specification_sha256",
        "task_sha256",
        "starting_repository_digest",
        "model_id",
        "client_surface",
        "platform",
        "python_version",
        "budget_units",
        "trial_id"
      ],
      "properties": {
        "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "specification_sha256": {"$ref": "#/$defs/sha256"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "starting_repository_digest": {"$ref": "#/$defs/sha256"},
        "model_id": {"$ref": "#/$defs/text"},
        "client_surface": {"$ref": "#/$defs/text"},
        "platform": {"enum": ["windows", "linux", "macos"]},
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        },
        "budget_units": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "trial_id": {
          "type": "string",
          "pattern": "^TRIAL-[A-Z0-9][A-Z0-9-]{0,63}$"
        }
      },
      "additionalProperties": false
    },
    "intervention": {"$ref": "#/$defs/text"},
    "intervention_sha256": {"$ref": "#/$defs/sha256"},
    "requirements_implemented": {"$ref": "#/$defs/identifierArray"},
    "scope_additions": {"$ref": "#/$defs/identifierArray"},
    "critical_defects": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "defect_id",
          "category",
          "requirement_ids",
          "description",
          "resolved"
        ],
        "properties": {
          "defect_id": {"$ref": "#/$defs/identifier"},
          "category": {"enum": ["must", "security", "data_loss", "disclosure"]},
          "requirement_ids": {
            "allOf": [
              {"$ref": "#/$defs/identifierArray"},
              {"minItems": 1}
            ]
          },
          "description": {"$ref": "#/$defs/text"},
          "resolved": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "rework_events": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["event_id", "failure_signature", "description"],
        "properties": {
          "event_id": {"$ref": "#/$defs/identifier"},
          "failure_signature": {"$ref": "#/$defs/identifier"},
          "description": {"$ref": "#/$defs/text"}
        },
        "additionalProperties": false
      }
    },
    "approvals": {"$ref": "#/$defs/identifierArray"},
    "handoffs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["handoff_id", "status"],
        "properties": {
          "handoff_id": {"$ref": "#/$defs/identifier"},
          "status": {"enum": ["PASSED", "FAILED"]}
        },
        "additionalProperties": false
      }
    },
    "trace": {"$ref": "#/$defs/nonemptyTextArray"},
    "decisions": {"$ref": "#/$defs/nonemptyTextArray"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "evidence_type",
          "status",
          "path",
          "sha256",
          "observed_at",
          "command"
        ],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/identifier"},
          "evidence_type": {
            "enum": ["TEST", "SOURCE_REVIEW", "MANUAL_REVIEW", "HANDOFF"]
          },
          "status": {"enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
          "path": {"$ref": "#/$defs/path"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "observed_at": {"type": "string", "format": "date-time"},
          "command": {"$ref": "#/$defs/text"}
        },
        "additionalProperties": false
      }
    },
    "cause_analyses": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "failure_signature",
          "layers",
          "owner",
          "action",
          "status",
          "verification_evidence"
        ],
        "properties": {
          "failure_signature": {"$ref": "#/$defs/identifier"},
          "layers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": ["instructions", "skill", "schema", "tests", "implementation"]
            }
          },
          "owner": {"$ref": "#/$defs/text"},
          "action": {"$ref": "#/$defs/text"},
          "status": {"enum": ["open", "verified"]},
          "verification_evidence": {"$ref": "#/$defs/identifierArray"}
        },
        "additionalProperties": false
      }
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "elapsed_seconds",
            "tool_calls",
            "input_tokens",
            "output_tokens",
            "reason"
          ],
          "properties": {
            "status": {"const": "AVAILABLE"},
            "elapsed_seconds": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "tool_calls": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "input_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "output_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000},
            "reason": {"type": "null"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "elapsed_seconds",
            "tool_calls",
            "input_tokens",
            "output_tokens",
            "reason"
          ],
          "properties": {
            "status": {"const": "NOT_VERIFIED"},
            "elapsed_seconds": {"type": "null"},
            "tool_calls": {"type": "null"},
            "input_tokens": {"type": "null"},
            "output_tokens": {"type": "null"},
            "reason": {"$ref": "#/$defs/text"}
          },
          "additionalProperties": false
        }
      ]
    },
    "limitations": {"$ref": "#/$defs/nonemptyTextArray"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![/.])(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,63}$"},
    "identifierArray": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "nonemptyTextArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "additionalProperties": false
}
