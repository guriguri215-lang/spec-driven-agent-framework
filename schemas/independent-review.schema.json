{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/independent-review.schema.json",
  "title": "Independent Read-Only Review",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "baseline_id",
    "candidate",
    "reviewed_at",
    "reviewer_id",
    "reviewed_agent_ids",
    "status",
    "read_only",
    "areas",
    "findings",
    "reviewed_paths",
    "changed_paths"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "pattern": "^REV-[A-Z0-9][A-Z0-9-]{0,63}$"},
    "baseline_id": {"type": "string", "pattern": "^RB-[0-9A-F]{16}$"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewer_id": {"$ref": "#/$defs/agentId"},
    "reviewed_agent_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/agentId"}
    },
    "status": {"enum": ["completed", "blocked", "rejected"]},
    "read_only": {"const": true},
    "areas": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["regression", "security", "maintainability"]}
    },
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/finding"}
    },
    "reviewed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\.(?:/|$))(?!.*/$)(?!.*(?:^|/)~)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "changed_paths": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^AGT-[A-Z0-9][A-Z0-9-]{0,63}$"
    },
    "candidate": {
      "type": "object",
      "required": [
        "source_spec_sha256",
        "git_head",
        "repository_digest"
      ],
      "properties": {
        "source_spec_sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_digest": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "finding_id",
        "severity",
        "status",
        "statement",
        "specification_refs",
        "evidence_refs",
        "approval_id"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^FND-[A-Z0-9][A-Z0-9-]{0,63}$"
        },
        "severity": {"enum": ["low", "medium", "high", "critical"]},
        "status": {"enum": ["open", "resolved", "accepted"]},
        "statement": {"type": "string", "minLength": 1, "maxLength": 500},
        "specification_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "approval_id": {
          "type": ["string", "null"],
          "pattern": "^APR-[A-Z0-9][A-Z0-9-]{0,63}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
