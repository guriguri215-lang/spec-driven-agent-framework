{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/migration-result.schema.json",
  "title": "M4 Schema Migration Result",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "contract",
    "root_sha256",
    "source_path",
    "source_version",
    "target_version",
    "source_sha256",
    "tool_registry_path",
    "tool_registry_sha256",
    "output_sha256",
    "inserted_defaults",
    "warnings",
    "source_preserved",
    "output_path",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "contract": {"enum": ["agent-registry", "tool-registry"]},
    "root_sha256": {"$ref": "#/$defs/sha256"},
    "source_path": {"$ref": "#/$defs/path"},
    "source_version": {"const": "1.0"},
    "target_version": {"const": "2.0"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "tool_registry_path": {
      "oneOf": [
        {"$ref": "#/$defs/path"},
        {"type": "null"}
      ]
    },
    "tool_registry_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "inserted_defaults": {"$ref": "#/$defs/nonemptyTextArray"},
    "warnings": {"$ref": "#/$defs/nonemptyTextArray"},
    "source_preserved": {"const": true},
    "output_path": {"$ref": "#/$defs/path"},
    "rollback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^Remove only the newly created [A-Za-z0-9._/-]+ file\\.$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"contract": {"const": "agent-registry"}}
      },
      "then": {
        "properties": {
          "tool_registry_path": {"$ref": "#/$defs/path"},
          "tool_registry_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {
        "properties": {"contract": {"const": "tool-registry"}}
      },
      "then": {
        "properties": {
          "tool_registry_path": {"type": "null"},
          "tool_registry_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![/.])(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[A-Za-z0-9._/-]+\\.json$"
    },
    "nonemptyTextArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^[^\\r\\n\\u0000]+$"
      }
    }
  },
  "additionalProperties": false
}
