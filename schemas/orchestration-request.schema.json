{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/orchestration-request.schema.json",
  "title": "Orchestration Request",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "problem_type",
    "scale",
    "risk",
    "parallelism",
    "requested_roles",
    "native_subagents_available",
    "independent_session_available",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "pattern": "^ORQ-[A-Z0-9][A-Z0-9-]{0,63}$"},
    "problem_type": {
      "enum": ["discovery", "implementation", "test_design", "log_analysis", "review"]
    },
    "scale": {"enum": ["small", "medium", "large"]},
    "risk": {"enum": ["low", "medium", "high", "prohibited"]},
    "parallelism": {"enum": ["sequential", "read_parallel", "write_parallel"]},
    "requested_roles": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "native_subagents_available": {"type": "boolean"},
    "independent_session_available": {"type": "boolean"},
    "budget": {
      "type": "object",
      "required": ["max_agents", "max_concurrency", "max_reasoning_effort"],
      "properties": {
        "max_agents": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_reasoning_effort": {"enum": ["low", "medium", "high"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
