{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/tool-registry-v2.schema.json",
  "title": "Tool Registry v2",
  "type": "object",
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "name",
          "capability",
          "version_command",
          "version_pattern",
          "minimum_version",
          "platforms",
          "normal_scope",
          "protected_paths",
          "network",
          "optional",
          "risk",
          "technical_approval",
          "owner_approval",
          "max_attempts"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "capability": {"type": "string", "minLength": 1, "maxLength": 500},
          "version_command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          },
          "version_pattern": {"type": "string", "minLength": 1, "maxLength": 500},
          "minimum_version": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["windows", "linux", "macos"]}
          },
          "normal_scope": {"$ref": "#/$defs/paths"},
          "protected_paths": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 240}
          },
          "network": {
            "type": "object",
            "required": ["required", "destinations"],
            "properties": {
              "required": {"type": "boolean"},
              "destinations": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": {"type": "string", "format": "uri"}
              }
            },
            "additionalProperties": false
          },
          "optional": {"type": "boolean"},
          "risk": {"enum": ["low", "medium", "high", "prohibited"]},
          "technical_approval": {
            "enum": ["not_required", "may_be_required", "required", "prohibited"]
          },
          "owner_approval": {
            "enum": ["not_required", "may_be_required", "required", "prohibited"]
          },
          "max_attempts": {"enum": [1, 2]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  },
  "additionalProperties": false
}
