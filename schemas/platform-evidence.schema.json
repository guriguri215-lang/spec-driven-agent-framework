{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/platform-evidence.schema.json",
  "title": "M4 Platform Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "milestone",
    "candidate",
    "matrix",
    "macos",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "milestone": {"const": "M4"},
    "candidate": {
      "type": "object",
      "required": [
        "git_head",
        "repository_digest",
        "canonical_specification_sha256",
        "workflow_path",
        "workflow_sha256"
      ],
      "properties": {
        "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_digest": {"$ref": "#/$defs/sha256"},
        "canonical_specification_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_path": {"const": ".github/workflows/ci.yml"},
        "workflow_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "platform",
          "python",
          "status",
          "commands",
          "source",
          "run_id"
        ],
        "properties": {
          "platform": {"enum": ["windows", "linux"]},
          "python": {"enum": ["3.12", "3.13"]},
          "status": {"enum": ["PASS", "NOT_VERIFIED"]},
          "commands": {"$ref": "#/$defs/commands"},
          "source": {"enum": ["local", "exact-sha-ci", "not-run"]},
          "run_id": {"type": ["integer", "null"], "minimum": 1}
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": {"status": {"const": "PASS"}}
            },
            "then": {
              "properties": {
                "commands": {"minItems": 1},
                "source": {"enum": ["local", "exact-sha-ci"]}
              }
            }
          },
          {
            "if": {
              "required": ["status"],
              "properties": {"status": {"const": "NOT_VERIFIED"}}
            },
            "then": {
              "properties": {
                "commands": {"maxItems": 0},
                "source": {"const": "not-run"},
                "run_id": {"type": "null"}
              }
            }
          },
          {
            "if": {
              "required": ["source"],
              "properties": {"source": {"const": "exact-sha-ci"}}
            },
            "then": {
              "properties": {
                "run_id": {"type": "integer", "minimum": 1}
              }
            }
          },
          {
            "if": {
              "required": ["source"],
              "properties": {"source": {"const": "local"}}
            },
            "then": {
              "properties": {
                "run_id": {"type": "null"}
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "macos": {
      "type": "object",
      "required": ["status", "reason", "commands", "source", "run_id"],
      "properties": {
        "status": {"enum": ["PASS", "NOT_VERIFIED"]},
        "reason": {"$ref": "#/$defs/text"},
        "commands": {"$ref": "#/$defs/commands"},
        "source": {"enum": ["local", "exact-sha-ci", "not-run"]},
        "run_id": {"type": ["integer", "null"], "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "PASS"}}
          },
            "then": {
              "properties": {
              "commands": {"minItems": 1},
              "source": {"enum": ["local", "exact-sha-ci"]}
            }
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "NOT_VERIFIED"}}
          },
            "then": {
              "properties": {
              "commands": {"maxItems": 0},
              "source": {"const": "not-run"},
              "run_id": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "required": ["source"],
            "properties": {"source": {"const": "exact-sha-ci"}}
          },
          "then": {
            "properties": {
              "run_id": {"type": "integer", "minimum": 1}
            }
          }
        },
        {
          "if": {
            "required": ["source"],
            "properties": {"source": {"const": "local"}}
          },
          "then": {
            "properties": {
              "run_id": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "commands": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^[^\\r\\n\\u0000]+$"
    }
  },
  "additionalProperties": false
}
