{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/context-graph.schema.json",
  "title": "Context Graph",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_id", "content"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "context-graph"},
    "artifact_id": {"$ref": "context-manifest.schema.json#/$defs/graph_id"},
    "content": {
      "type": "object",
      "required": [
        "candidate",
        "manifest_id",
        "sensitivity",
        "nodes",
        "edges",
        "excluded_sources"
      ],
      "properties": {
        "candidate": {"$ref": "context-manifest.schema.json#/$defs/candidate"},
        "manifest_id": {"$ref": "context-manifest.schema.json#/$defs/manifest_id"},
        "sensitivity": {
          "$ref": "context-manifest.schema.json#/$defs/adoptable_sensitivity"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/edge"}
        },
        "excluded_sources": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_exclusion"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "source_id",
        "kind",
        "title",
        "text",
        "text_sha256",
        "locator",
        "provenance",
        "authority",
        "freshness",
        "sensitivity",
        "identifiers",
        "labels",
        "required"
      ],
      "properties": {
        "node_id": {"$ref": "context-manifest.schema.json#/$defs/node_id"},
        "source_id": {"$ref": "context-manifest.schema.json#/$defs/source_id"},
        "kind": {"$ref": "context-manifest.schema.json#/$defs/source_kind"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "text": {"type": "string", "maxLength": 65536},
        "text_sha256": {"$ref": "context-manifest.schema.json#/$defs/sha256"},
        "locator": {"$ref": "context-manifest.schema.json#/$defs/locator"},
        "provenance": {"$ref": "context-manifest.schema.json#/$defs/provenance"},
        "authority": {"$ref": "context-manifest.schema.json#/$defs/authority"},
        "freshness": {"$ref": "context-manifest.schema.json#/$defs/freshness"},
        "sensitivity": {
          "$ref": "context-manifest.schema.json#/$defs/adoptable_sensitivity"
        },
        "identifiers": {
          "$ref": "context-manifest.schema.json#/$defs/short_text_array"
        },
        "labels": {"$ref": "context-manifest.schema.json#/$defs/label_array"},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "edge_id",
        "edge_type",
        "source_node_id",
        "target_node_id",
        "provenance"
      ],
      "properties": {
        "edge_id": {"$ref": "context-manifest.schema.json#/$defs/edge_id"},
        "edge_type": {"$ref": "context-manifest.schema.json#/$defs/edge_type"},
        "source_node_id": {
          "$ref": "context-manifest.schema.json#/$defs/node_id"
        },
        "target_node_id": {
          "$ref": "context-manifest.schema.json#/$defs/node_id"
        },
        "provenance": {"$ref": "context-manifest.schema.json#/$defs/provenance"}
      },
      "additionalProperties": false
    },
    "source_exclusion": {
      "type": "object",
      "required": ["source_id", "reason", "details"],
      "properties": {
        "source_id": {"$ref": "context-manifest.schema.json#/$defs/source_id"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 100},
        "details": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      },
      "additionalProperties": false
    }
  }
}
