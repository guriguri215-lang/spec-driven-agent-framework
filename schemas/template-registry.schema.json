{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/template-registry.schema.json",
  "title": "Template Registry",
  "type": "object",
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "template_id",
          "target",
          "compatible_version",
          "dependencies",
          "provenance",
          "license_status",
          "prohibited_conditions",
          "validated_on"
        ],
        "properties": {
          "template_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "target": {"type": "string", "minLength": 1, "maxLength": 240},
          "compatible_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
          "dependencies": {"$ref": "#/$defs/strings"},
          "provenance": {"type": "string", "minLength": 1, "maxLength": 500},
          "license_status": {"enum": ["internal", "not-selected", "external-approved"]},
          "prohibited_conditions": {"$ref": "#/$defs/strings"},
          "validated_on": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "additionalProperties": false
}
