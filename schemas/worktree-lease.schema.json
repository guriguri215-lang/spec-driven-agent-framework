{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/worktree-lease.schema.json",
  "title": "M6 Worktree Lease",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_id", "content"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "worktree-lease"},
    "artifact_id": {
      "$ref": "task-graph.schema.json#/$defs/worktree_lease_id"
    },
    "content": {
      "type": "object",
      "required": [
        "graph_id",
        "task_id",
        "worktree_plan",
        "base_commit",
        "worktree",
        "owner_id",
        "owned_paths",
        "fence",
        "observed_digest",
        "status",
        "integration_state",
        "ambiguous",
        "recovery_guidance"
      ],
      "properties": {
        "graph_id": {"$ref": "task-graph.schema.json#/$defs/task_graph_id"},
        "task_id": {"$ref": "task-graph.schema.json#/$defs/task_id"},
        "worktree_plan": {"$ref": "task-graph.schema.json#/$defs/reference"},
        "base_commit": {"$ref": "task-graph.schema.json#/$defs/commit"},
        "worktree": {"$ref": "task-graph.schema.json#/$defs/safe_path"},
        "owner_id": {"$ref": "task-graph.schema.json#/$defs/host_or_worker_id"},
        "owned_paths": {"$ref": "task-graph.schema.json#/$defs/path_set"},
        "fence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "observed_digest": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "task-graph.schema.json#/$defs/sha256"}
          ]
        },
        "status": {
          "enum": ["requested", "observed", "integrated", "released", "blocked"]
        },
        "integration_state": {
          "enum": ["not_started", "requested", "verified", "ambiguous"]
        },
        "ambiguous": {"type": "boolean"},
        "recovery_guidance": {
          "$ref": "#/$defs/path_free_text"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "path_free_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?!\\s*$)[^\\u0000-\\u001F\\u007F\\u202A-\\u202E\\u2066-\\u2069]*$",
      "allOf": [
        {"not": {"pattern": "AKIA[0-9A-Z]{16}"}},
        {"not": {"pattern": "gh[pousr]_[A-Za-z0-9]{20,}"}},
        {
          "not": {
            "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"
          }
        },
        {"not": {"pattern": "[A-Za-z]:[\\\\/]"}},
        {
          "not": {
            "pattern": "/(?:[Ee][Tt][Cc]|[Hh][Oo][Mm][Ee]|[Oo][Pp][Tt]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Rr][Oo][Oo][Tt]|[Tt][Mm][Pp]|[Uu][Ss][Rr]|[Vv][Aa][Rr]|[Uu][Ss][Ee][Rr][Ss])(?:/|$)"
          }
        }
      ]
    }
  }
}
