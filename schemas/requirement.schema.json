{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/requirement.schema.json",
  "title": "Requirement List",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "type", "priority", "status", "source", "statement", "acceptance_criteria", "verification", "assumptions", "open_questions"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
      "title": {"type": "string", "minLength": 1},
      "type": {"enum": ["functional", "nonfunctional", "constraint", "non-goal"]},
      "priority": {"enum": ["must", "should", "could"]},
      "status": {"enum": ["draft", "baselined", "implemented", "verified", "rejected"]},
      "source": {
        "type": "object",
        "required": ["document", "section"],
        "properties": {
          "document": {"type": "string"},
          "section": {"type": "string"}
        },
        "additionalProperties": false
      },
      "statement": {"type": "string", "minLength": 1},
      "acceptance_criteria": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "statement"],
          "properties": {
            "id": {"type": "string"},
            "statement": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "verification": {"type": "array", "items": {"type": "string"}},
      "assumptions": {"type": "array", "items": {"type": "string"}},
      "open_questions": {"type": "array", "items": {"type": "string"}}
    },
    "additionalProperties": false
  }
}
