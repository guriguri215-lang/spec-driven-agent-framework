{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/tool-execution-approval.schema.json",
  "title": "Single-execution tool approval",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "action",
    "scope",
    "risk",
    "status",
    "rationale",
    "reversible",
    "approved_by",
    "approved_at",
    "expires_at",
    "lifetime",
    "conditions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "approval_type": {"enum": ["owner", "technical_sandbox"]},
    "action": {"const": "Execute one registered tool version probe"},
    "scope": {
      "type": "object",
      "required": [
        "tool_name",
        "command",
        "normal_scope",
        "protected_paths",
        "network_destinations"
      ],
      "properties": {
        "tool_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "normal_scope": {"$ref": "#/$defs/paths"},
        "protected_paths": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "network_destinations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        }
      },
      "additionalProperties": false
    },
    "risk": {"enum": ["low", "medium", "high"]},
    "status": {"const": "approved"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
    "reversible": {"const": true},
    "approved_by": {"enum": ["Owner", "Technical sandbox reviewer"]},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "lifetime": {"const": "single_execution"},
    "conditions": {
      "type": "object",
      "required": ["execution", "max_executions"],
      "properties": {
        "execution": {"const": "version_probe"},
        "max_executions": {"const": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  },
  "additionalProperties": false
}
