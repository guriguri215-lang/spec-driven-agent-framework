{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/agent-result.schema.json",
  "title": "Structured Agent Result",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "role_id",
    "status",
    "summary",
    "findings",
    "changed_paths",
    "reviewed_agent_ids",
    "self_approved"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "agent_id": {"type": "string", "pattern": "^AGT-[A-Z0-9][A-Z0-9-]{0,63}$"},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "status": {"enum": ["completed", "blocked", "rejected"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "statement",
          "specification_refs",
          "evidence_refs",
          "evidence_strength",
          "counterexample"
        ],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^FND-[A-Z0-9][A-Z0-9-]{0,63}$"},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500},
          "specification_refs": {"$ref": "#/$defs/references"},
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "evidence_strength": {
            "enum": ["unverified", "indirect", "direct", "counterexample"]
          },
          "counterexample": {"type": ["string", "null"], "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "reviewed_agent_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AGT-[A-Z0-9][A-Z0-9-]{0,63}$"}
    },
    "self_approved": {"const": false}
  },
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  },
  "additionalProperties": false
}
