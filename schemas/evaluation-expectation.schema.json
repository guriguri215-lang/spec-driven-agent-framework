{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/evaluation-expectation.schema.json",
  "title": "M4 Normalization Expectation",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "source_sha256",
    "baseline_id",
    "requirements",
    "diagnostic_kinds"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "baseline_id": {"type": "string", "pattern": "^RB-[0-9A-F]{16}$"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "type",
          "priority",
          "statement",
          "acceptance_ids",
          "verification_methods"
        ],
        "properties": {
          "requirement_id": {"$ref": "#/$defs/identifier"},
          "type": {
            "enum": [
              "functional",
              "nonfunctional",
              "constraint",
              "non-goal",
              "assumption",
              "open-decision"
            ]
          },
          "priority": {"enum": ["must", "should", "could"]},
          "statement": {"$ref": "#/$defs/text"},
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/identifier"}
          },
          "verification_methods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostic_kinds": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "enum": [
          "ambiguity",
          "contradiction",
          "duplicate-identifier",
          "duplicate-statement",
          "missing-assumption",
          "unverifiable"
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{1,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\r\\n\\u0000]+$"
    }
  },
  "additionalProperties": false
}
