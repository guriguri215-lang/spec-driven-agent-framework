{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/migration-approval.schema.json",
  "title": "M4 Migration Owner Approval",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "approval_type",
    "action",
    "scope",
    "risk",
    "status",
    "rationale",
    "reversible",
    "approved_by",
    "approved_at",
    "expires_at",
    "lifetime",
    "conditions"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "approval_id": {
      "type": "string",
      "pattern": "^APR-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "approval_type": {"const": "owner"},
    "action": {"const": "Migrate one registry schema"},
    "scope": {
      "type": "object",
      "required": [
        "contract",
        "root_sha256",
        "source_path",
        "source_sha256",
        "output_path",
        "tool_registry_path",
        "tool_registry_sha256",
        "source_version",
        "target_version"
      ],
      "properties": {
        "contract": {"enum": ["agent-registry", "tool-registry"]},
        "root_sha256": {"$ref": "#/$defs/sha256"},
        "source_path": {"$ref": "#/$defs/path"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "output_path": {"$ref": "#/$defs/path"},
        "tool_registry_path": {
          "oneOf": [
            {"$ref": "#/$defs/path"},
            {"type": "null"}
          ]
        },
        "tool_registry_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "source_version": {"const": "1.0"},
        "target_version": {"const": "2.0"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"contract": {"const": "agent-registry"}}
          },
          "then": {
            "properties": {
              "tool_registry_path": {"$ref": "#/$defs/path"},
              "tool_registry_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {
            "properties": {"contract": {"const": "tool-registry"}}
          },
          "then": {
            "properties": {
              "tool_registry_path": {"type": "null"},
              "tool_registry_sha256": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "risk": {"const": "medium"},
    "status": {"const": "approved"},
    "rationale": {"$ref": "#/$defs/text"},
    "reversible": {"const": true},
    "approved_by": {"const": "Owner"},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "lifetime": {"const": "single_use"},
    "conditions": {
      "type": "object",
      "required": ["source_preserved", "exclusive_output"],
      "properties": {
        "source_preserved": {"const": true},
        "exclusive_output": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?![/.])(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[A-Za-z0-9._/-]+\\.json$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n\\u0000]+$"
    }
  },
  "additionalProperties": false
}
