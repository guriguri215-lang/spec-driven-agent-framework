{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/worktree-plan.schema.json",
  "title": "Worktree Isolation Plan",
  "type": "object",
  "required": ["schema_version", "base_commit", "integrator_role", "assignments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "integrator_role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "assignments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["role_id", "worktree", "owned_paths"],
        "properties": {
          "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "worktree": {"type": "string", "minLength": 1, "maxLength": 240},
          "owned_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
