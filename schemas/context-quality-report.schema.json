{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/context-quality-report.schema.json",
  "title": "Context Quality Report",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_id", "content"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "context-quality-report"},
    "artifact_id": {"$ref": "context-manifest.schema.json#/$defs/quality_id"},
    "content": {
      "type": "object",
      "required": [
        "candidate",
        "snapshot_id",
        "sensitivity",
        "required_reference_recall",
        "stale_required_count",
        "provenance_complete_count",
        "provenance_missing_count",
        "sensitivity_violation_count",
        "selected_context_bytes",
        "budget_bytes",
        "redundant_bytes",
        "selected_node_count",
        "excluded_node_count",
        "unresolved_contradiction_count",
        "traversal_truncated"
      ],
      "properties": {
        "candidate": {"$ref": "context-manifest.schema.json#/$defs/candidate"},
        "snapshot_id": {"$ref": "context-manifest.schema.json#/$defs/snapshot_id"},
        "sensitivity": {
          "$ref": "context-manifest.schema.json#/$defs/adoptable_sensitivity"
        },
        "required_reference_recall": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stale_required_count": {"$ref": "#/$defs/count"},
        "provenance_complete_count": {"$ref": "#/$defs/count"},
        "provenance_missing_count": {"$ref": "#/$defs/count"},
        "sensitivity_violation_count": {"$ref": "#/$defs/count"},
        "selected_context_bytes": {"$ref": "#/$defs/count"},
        "budget_bytes": {"$ref": "#/$defs/count"},
        "redundant_bytes": {"$ref": "#/$defs/count"},
        "selected_node_count": {"$ref": "#/$defs/count"},
        "excluded_node_count": {"$ref": "#/$defs/count"},
        "unresolved_contradiction_count": {"$ref": "#/$defs/count"},
        "traversal_truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 16777216}
  }
}
