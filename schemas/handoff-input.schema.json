{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdaqf/handoff-input.schema.json",
  "title": "Automated Handoff Input",
  "type": "object",
  "required": [
    "schema_version",
    "milestone",
    "status",
    "completed",
    "incomplete",
    "evidence_ids",
    "open_decisions",
    "known_problems",
    "recommended_next",
    "primary_folder",
    "approval_stops",
    "next_prompt_context"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "milestone": {"type": "string", "pattern": "^M[0-9]+$"},
    "status": {
      "enum": [
        "planned",
        "ready",
        "running",
        "blocked",
        "verification",
        "completed",
        "rejected",
        "superseded"
      ]
    },
    "completed": {"$ref": "#/$defs/strings"},
    "incomplete": {"$ref": "#/$defs/strings"},
    "evidence_ids": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EV-[A-Z0-9][A-Z0-9-]{0,63}$"
      }
    },
    "open_decisions": {"$ref": "#/$defs/strings"},
    "known_problems": {"$ref": "#/$defs/strings"},
    "recommended_next": {"type": "string", "minLength": 1, "maxLength": 500},
    "primary_folder": {"enum": ["repo", "repo/"]},
    "approval_stops": {"$ref": "#/$defs/nonemptyStrings"},
    "next_prompt_context": {"$ref": "#/$defs/context"}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "safeReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\.(?:/|$))(?!.*/$)(?!.*(?:^|/)~)(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:[.]|/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "context": {
      "type": "object",
      "required": [
        "role",
        "references",
        "change_scope",
        "exclusions",
        "completion_criteria",
        "stop_conditions"
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1, "maxLength": 200},
        "references": {"$ref": "#/$defs/safeReferences"},
        "change_scope": {"$ref": "#/$defs/nonemptyStrings"},
        "exclusions": {"$ref": "#/$defs/nonemptyStrings"},
        "completion_criteria": {"$ref": "#/$defs/nonemptyStrings"},
        "stop_conditions": {"$ref": "#/$defs/nonemptyStrings"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}},
      "then": {
        "properties": {
          "incomplete": {"maxItems": 0},
          "open_decisions": {"maxItems": 0},
          "known_problems": {"maxItems": 0}
        }
      }
    }
  ],
  "additionalProperties": false
}
